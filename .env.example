# files:  messages wait in data/inbox for an external agent (Claude Code / Codex).
# gemini: the server answers each message itself through the Gemini API.
BACKEND=files
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
# Rootless podman only: keep-id maps container uid 1000 to your user so ./data is writable.
USERNS_MODE=
