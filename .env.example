# BACKEND is set per service in compose.yaml (app = files, app-gemini = gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Rootless podman only: keep-id maps container uid 1000 to your user so .messages/ is writable.
USERNS_MODE=
# Gemini spend limit per server process, $ per hour (docs/gemini-costs.md)
GEMINI_SPEND_PER_HOUR=10
# Thinking level: medium (default), high or low
GEMINI_THINKING_LEVEL=medium
